<div class="op-module-counter-calendar">
	<div class="op-module-counter-calendar-header">
		<a class="op-module-counter-calendar-nav" href="?counter_year=<?= $calendar['previous']['year'] ?>&amp;counter_month=<?= $calendar['previous']['month'] ?>" aria-label="Previous month">&lt;</a>
		<div class="op-module-counter-calendar-title"><?= htmlspecialchars($calendar['label'], ENT_QUOTES, 'UTF-8') ?></div>
		<a class="op-module-counter-calendar-nav" href="?counter_year=<?= $calendar['next']['year'] ?>&amp;counter_month=<?= $calendar['next']['month'] ?>" aria-label="Next month">&gt;</a>
	</div>
	<table class="op-module-counter-calendar-table">
		<thead>
			<tr>
				<th scope="col">Sun</th>
				<th scope="col">Mon</th>
				<th scope="col">Tue</th>
				<th scope="col">Wed</th>
				<th scope="col">Thu</th>
				<th scope="col">Fri</th>
				<th scope="col">Sat</th>
			</tr>
		</thead>
		<tbody>
			<?php foreach( $calendar['weeks'] as $week ): ?>
			<?php /* @var $week array */ ?>
			<tr>
				<?php foreach( $week as $day ): ?>
					<?php /* @var $day array|null */ ?>
					<?php if( $day === null ): ?>
					<td class="op-module-counter-calendar-empty"></td>
					<?php else: ?>
					<td class="<?= $day['is_today'] ? 'op-module-counter-calendar-today' : '' ?>" data-date="<?= $day['date'] ?>">
						<div class="op-module-counter-calendar-day">
							<time class="op-module-counter-calendar-date" datetime="<?= $day['date'] ?>" aria-label="<?= htmlspecialchars($day['date'], ENT_QUOTES, 'UTF-8') ?>"><?= $day['day'] ?></time>
						</div>
						<div class="op-module-counter-calendar-count <?= $day['count'] === 0 ? 'op-module-counter-calendar-count-zero' : '' ?>"><?= number_format($day['count']) ?></div>
					</td>
					<?php endif; ?>
				<?php endforeach; ?>
			</tr>
			<?php endforeach; ?>
		</tbody>
	</table>
</div>
