<style>
.op-module-counter-calendar {
	inline-size: min(100%, 42rem);
}
.op-module-counter-calendar-header {
	display: grid;
	grid-template-columns: 2.5rem 1fr 2.5rem;
	align-items: center;
	margin-block-end: 0.5rem;
}
.op-module-counter-calendar-title {
	font-weight: 700;
	text-align: center;
}
.op-module-counter-calendar-nav {
	text-align: center;
	text-decoration: none;
}
.op-module-counter-calendar-table {
	border-collapse: collapse;
	inline-size: 100%;
	table-layout: fixed;
}
.op-module-counter-calendar-table th,
.op-module-counter-calendar-table td {
	border: 1px solid #d6d6d6;
	padding: 0.35rem;
	vertical-align: top;
}
.op-module-counter-calendar-table th {
	background: #f2f4f6;
	font-weight: 700;
	text-align: center;
}
.op-module-counter-calendar-table td {
	block-size: 4.25rem;
}
.op-module-counter-calendar-empty {
	background: #fafafa;
}
.op-module-counter-calendar-day {
	text-align: left;
}
.op-module-counter-calendar-date {
	font-weight: 700;
}
.op-module-counter-calendar-table td:first-child .op-module-counter-calendar-date {
	color: #c62828;
}
.op-module-counter-calendar-table td:last-child .op-module-counter-calendar-date {
	color: #1565c0;
}
